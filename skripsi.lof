\contentsline {figure}{\numberline {\bbl@ensure@indonesian {Gambar}~5.1.}{\ignorespaces Limit daya KRUSTY: perbandingan model dan data eksperimen. Kurva hitam putus-putus adalah limit yang mengendalikan; titik putih adalah data terdigitalisasi.}}{29}{figure.caption.45}%
\contentsline {figure}{\numberline {\bbl@ensure@indonesian {Gambar}~5.2.}{\ignorespaces Limit daya satu \emph {heat pipe} 0,6 cm untuk Na, K, dan Li. Garis putus-putus menunjukkan kebutuhan 8,2 kW per pin.}}{32}{figure.caption.46}%
\contentsline {figure}{\numberline {\bbl@ensure@indonesian {Gambar}~5.3.}{\ignorespaces Diameter luar yang diperlukan untuk membawa 8,2 kW per pin sebagai fungsi suhu uap, dibandingkan dengan kanal yang ada (0,6 cm) dan rongga bahan bakar (3,265 cm).}}{32}{figure.caption.47}%
\contentsline {figure}{\numberline {\bbl@ensure@indonesian {Gambar}~5.4.}{\ignorespaces Kapasitas pendinginan ketiga opsi (A, B, C) pada 1200 K dibandingkan dengan daya nominal 500 kWth. Opsi A dan B membawa daya penuh, sedangkan Opsi C diturunkan dayanya.}}{36}{figure.caption.49}%
\contentsline {figure}{\numberline {\bbl@ensure@indonesian {Gambar}~5.5.}{\ignorespaces Profil suhu dinding aksial: (kiri) KRUSTY pada 310 W; (kanan) \emph {heat pipe} ISR 0,6 cm pada 1,0 kW.}}{36}{figure.caption.50}%
\contentsline {figure}{\numberline {\bbl@ensure@indonesian {Gambar}~5.6.}{\ignorespaces Respons termal pipa terhadap langkah daya 310 W (tanpa massa teras dan panas laten peleburan).}}{37}{figure.caption.51}%
